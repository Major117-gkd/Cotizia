<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

    <StackPane style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cotizia.cotizia.ui.CycleFormController">
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="20.0" styleClass="card" style="-fx-padding: 30; -fx-background-radius: 10;">
            <Label text="Nouveau Cycle" styleClass="title-label" />
            
            <GridPane hgap="20.0" vgap="15.0">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                </columnConstraints>
                
                <!-- Row 0: Nom & Montant -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <Label text="Nom du Cycle" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #546e7a;" />
                    <TextField fx:id="nomField" promptText="Ex: Tontine Janvier" />
                </VBox>
                
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <Label text="Montant Cotisation" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #546e7a;" />
                    <TextField fx:id="montantField" promptText="Ex: 50000 FG" />
                </VBox>

                <!-- Row 1: Date & Fréquence -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <Label text="Date de Début" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #546e7a;" />
                    <DatePicker fx:id="dateDebutPicker" promptText="Sélectionner une date" maxWidth="Infinity" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <Label text="Fréquence" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #546e7a;" />
                    <ComboBox fx:id="frequenceBox" promptText="Sélectionner..." maxWidth="Infinity">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="HEBDOMADAIRE" />
                                <String fx:value="MENSUELLE" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
            </GridPane>

            <HBox spacing="15.0" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                <Label fx:id="errorLabel" textFill="#e53935" wrapText="true" maxWidth="200" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Annuler" onAction="#handleCancel" styleClass="button-secondary" style="-fx-text-fill: #546e7a; -fx-border-color: #cfd8dc;" />
                <Button text="Créer" onAction="#handleCreate" styleClass="button" />
            </HBox>
        </VBox>
    </StackPane>
