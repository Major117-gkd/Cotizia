<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>

    <StackPane style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cotizia.cotizia.ui.PaymentController">
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label fx:id="titleLabel" text="Gestion des Paiements" styleClass="title-label" />
                 <Region HBox.hgrow="ALWAYS" />
                 <Button text="Retour" onAction="#handleBack" styleClass="button-secondary" style="-fx-text-fill: #546e7a; -fx-border-color: #cfd8dc;" />
            </HBox>

            <!-- Content Card -->
            <VBox spacing="15.0" styleClass="card" VBox.vgrow="ALWAYS">
                <Label fx:id="participantLabel" text="Participant: " styleClass="subtitle-label" />
                
                <ListView fx:id="echeanceListView" style="-fx-background-color: transparent; -fx-border-color: #eceff1;" VBox.vgrow="ALWAYS" />
                
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <Button fx:id="payButton" text="Marquer comme Payé" onAction="#handleMarkPaid" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="statusLabel" textFill="#00695c" style="-fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
