<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>

    <StackPane style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cotizia.cotizia.ui.ParticipantListController">
        <VBox spacing="20.0" style="-fx-padding: 30;">
        
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label fx:id="titleLabel" text="Participants du Cycle" styleClass="title-label" />
                 <Region HBox.hgrow="ALWAYS" />
                 <Button text="Retour" onAction="#handleBack" styleClass="button-secondary" style="-fx-text-fill: #546e7a; -fx-border-color: #cfd8dc;" />
            </HBox>
            
            <!-- Content Card -->
            <VBox spacing="15.0" styleClass="card" VBox.vgrow="ALWAYS">
                 <!-- Actions -->
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <ComboBox fx:id="adherentComboBox" promptText="Sélectionner un adhérent" HBox.hgrow="ALWAYS" style="-fx-max-width: 400px;"/>
                     <Button text="+ Ajouter" onAction="#handleAddParticipant" styleClass="button" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Button text="Voir Paiements" onAction="#handleViewPayments" styleClass="button-accent" />
                     <Button text="Exporter CSV" onAction="#handleExport" styleClass="button-secondary" style="-fx-text-fill: #546e7a; -fx-border-color: #cfd8dc;" />
                </HBox>
                
                <Label fx:id="statusLabel" textFill="#00695c" style="-fx-font-weight: bold;"/>

                <ListView fx:id="participantListView" style="-fx-background-color: transparent; -fx-border-color: #eceff1;" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>
    </StackPane>
