<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

    <StackPane style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cotizia.cotizia.ui.UserListController">
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label styleClass="title-label" text="Gestion des Utilisateurs" />
                 <Region HBox.hgrow="ALWAYS" />
                 <Button onAction="#handleBack" styleClass="button-secondary" style="-fx-text-fill: #546e7a; -fx-border-color: #cfd8dc;" text="Retour" />
            </HBox>
            
            <VBox spacing="15.0" styleClass="card" VBox.vgrow="ALWAYS">
                <TableView fx:id="userTableView" style="-fx-background-color: transparent; -fx-border-color: #eceff1;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="50.0" text="ID">
                            <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="120.0" text="Nom">
                            <cellValueFactory><PropertyValueFactory property="nom" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="120.0" text="Prénom">
                            <cellValueFactory><PropertyValueFactory property="prenom" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="180.0" text="Email">
                            <cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="100.0" text="Rôle">
                            <cellValueFactory><PropertyValueFactory property="role" /></cellValueFactory>
                        </TableColumn>
                    </columns>
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                   </columnResizePolicy>
                </TableView>
                
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                     <Label fx:id="statusLabel" textFill="#00695c" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Button onAction="#handleAddUser" styleClass="button" text="Ajouter" />
                     <Button onAction="#handleEditUser" styleClass="button-accent" text="Modifier" />
                     <Button onAction="#handleDeleteUser" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" text="Supprimer" />
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
