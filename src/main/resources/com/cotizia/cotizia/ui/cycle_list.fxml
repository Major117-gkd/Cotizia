<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

    <StackPane style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cotizia.cotizia.ui.CycleListController">
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label styleClass="title-label" text="Liste des Cycles" />
                 <Region HBox.hgrow="ALWAYS" />
                 <Button onAction="#handleBack" styleClass="button-secondary" style="-fx-text-fill: #546e7a; -fx-border-color: #cfd8dc;" text="Retour au Tableau de Bord" />
            </HBox>
            
            <VBox spacing="15.0" styleClass="card" VBox.vgrow="ALWAYS">
                 <HBox spacing="15.0">
                    <Button onAction="#handleNewCycle" styleClass="button" text="+ Nouveau Cycle" />
                     <Button onAction="#handleManageParticipants" styleClass="button-accent" text="Gérer Participants" />
                     <Button onAction="#handleExportPDF" styleClass="button-outlined" text="Exporter Rapport PDF" />
                 </HBox>
                
                <ListView fx:id="cycleListView" style="-fx-background-color: transparent; -fx-border-color: #eceff1;" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>
    </StackPane>
