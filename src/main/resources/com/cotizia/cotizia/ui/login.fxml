<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cotizia.cotizia.ui.LoginController" style="-fx-background-color: linear-gradient(to bottom right, #004d40, #00897b);">
    <children>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="25.0" styleClass="login-card">
            <children>
                <Label styleClass="title-label" text="Cotizia">
               <font>
                  <Font name="Segoe UI Bold" size="36.0" />
               </font></Label>
                <Label styleClass="subtitle-label" text="Gestion de Tontine Intelligente" />
            
                <VBox spacing="15.0" style="-fx-alignment: center-left;">
                    <Label text="EMAIL" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #78909c;" />
                    <TextField fx:id="emailField" prefWidth="300.0" promptText="exemple@email.com" />
                </VBox>
            
                <VBox spacing="15.0" style="-fx-alignment: center-left;">
                     <Label text="MOT DE PASSE" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #78909c;" />
                    <StackPane alignment="CENTER_LEFT">
                        <TextField fx:id="passwordTextField" prefWidth="300.0" promptText="Mot de passe" visible="false" managed="false"/>
                        <PasswordField fx:id="passwordField" prefWidth="300.0" promptText="••••••••" />
                    </StackPane>
                    <javafx.scene.control.CheckBox fx:id="showPasswordCheckBox" text="Afficher le mot de passe" onAction="#togglePasswordVisibility" style="-fx-text-fill: #78909c; -fx-cursor: hand;"/>
                </VBox>

                <Button maxWidth="Infinity" onAction="#handleLogin" text="SE CONNECTER" style="-fx-font-size: 16px; -fx-padding: 12 20;" />
                <Label fx:id="errorLabel" textFill="#e53935" wrapText="true" />
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
        </VBox>
    </children>
</StackPane>
